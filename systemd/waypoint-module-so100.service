[Unit]
Description=Waypoint module — so100 (SO-101 arm control + calibration)
After=waypoint-agent.service
Requires=waypoint-agent.service

[Service]
Type=notify
Environment=WAYPOINT_ROVER_ID=
EnvironmentFile=-/etc/waypoint/core.env
EnvironmentFile=-/data/waypoint/core.env
ExecStart=/usr/bin/waypoint-module-so100 \
  --config /run/waypoint/modules/so100/config.toml \
  --creds  /run/waypoint/modules/so100/creds.env \
  --rover  ${WAYPOINT_ROVER_ID}
Restart=always
RestartSec=2s
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
